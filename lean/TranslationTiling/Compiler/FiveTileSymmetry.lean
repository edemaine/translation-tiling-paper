theorem relabel_left_inverse : ∀ i : Fin 120, ∀ a, inverseFn i (relabelFn i a)=a := by decide +kernel

theorem relabel_right_inverse : ∀ i : Fin 120, ∀ a, relabelFn i (inverseFn i a)=a := by decide +kernel

def relabel (i : Fin 120) : Equiv.Perm Letter := ⟨relabelFn i,inverseFn i,relabel_left_inverse i,relabel_right_inverse i⟩

structure Orbit where
  mask : ℕ
  representative : Fin 676
  permutation : Fin 120

def Orbit.valid (e : Orbit) : Bool :=
  (List.finRange 5).all fun a => (List.finRange 5).all fun b =>
    decide (edge (caseMask e.representative) (relabel e.permutation a) (relabel e.permutation b)=edge e.mask a b)

theorem Orbit.edges (e : Orbit) (he : e.valid=true) (a b : Letter) :
    edge (caseMask e.representative) (relabel e.permutation a) (relabel e.permutation b)=edge e.mask a b := by
  exact of_decide_eq_true (List.all_eq_true.mp (List.all_eq_true.mp he a (by simp)) b (by simp))

theorem Orbit.complete (e : Orbit) (he : e.valid=true)
    (cs : Fin 676 → CheckedCase) (hcs : ∀ i, (cs i).mask=caseMask i)
    (H : ℕ) (V : Matrix) (W : ℕ → ℕ → Letter) (hr : Rectangular V) (hp : Patch H V W)
    (hm : ∀ a b, edge H a b=edge e.mask a b) : Plane H V := by
  let p := relabel e.permutation
  let V' : Matrix := fun a b => V (p.symm a) (p.symm b)
  let W' : ℕ → ℕ → Letter := fun x y => p (W x y)
  have hr' : Rectangular V' := by
    intro a b c d hac hbc
    exact hr _ _ _ _ hac hbc
  have hp' : Patch (caseMask e.representative) V' W' := by
    constructor
    · intro x y hx hy
      change edge (caseMask e.representative) (p (W x y)) (p (W (x+1) y))=true
      rw [e.edges he,←hm]
      exact hp.1 x y hx hy
    · intro x y hx hy
      simpa only [V',W',Equiv.symm_apply_apply] using hp.2 x y hx hy
  have hc := (cs e.representative).complete V' W' hr'
  rw [hcs] at hc
  obtain ⟨g,hg⟩ := hc hp'
  refine ⟨fun z => p.symm (g z),fun z => ⟨?_,(hg z).2⟩⟩
  rw [hm,←e.edges he]
  simpa only [p,Equiv.apply_symm_apply] using (hg z).1

theorem row_representable : ∀ f : Letter → Bool, ∃ r : Fin 32, ∀ b, f b=r.val.testBit b.val := by
  decide +kernel

