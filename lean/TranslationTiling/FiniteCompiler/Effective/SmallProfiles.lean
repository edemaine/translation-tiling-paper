import TranslationTiling.FiniteCompiler.Effective.Parameters
import Mathlib.Data.List.Nodup

/-! Dense, kernel-checked certificates for the five small ternary widths. -/
namespace TranslationTiling.FiniteCompiler.Effective.SmallProfiles
set_option maxRecDepth 10000
set_option Elab.async false
set_option maxHeartbeats 2000000
set_option exponentiation.threshold 20000

structure Profile where
  primes : List ℕ
  coeffA : List ℕ
  coeffB : List ℕ

def Profile.entry (p : Profile) (i : ℕ) : ℕ := p.primes.getD i 0

def Representation (p : Profile) (w c d : ℕ) : Prop :=
  0<p.coeffA.getD d 0 ∧ 0<p.coeffB.getD d 0 ∧
  p.entry (2*w+4+d)=p.coeffA.getD d 0*p.entry c+p.coeffB.getD d 0*p.entry (w+2+c)

instance (p : Profile) (w c d : ℕ) : Decidable (Representation p w c d) := by
  unfold Representation Profile.entry
  infer_instance

def Valid (w : ℕ) (p : Profile) : Prop :=
  p.primes.length=5*w+6 ∧ p.primes.Nodup ∧
  (∀ v∈p.primes, v.Prime ∧ v≠5 ∧ v≠7 ∧ v≤65536) ∧
  (∀ t∈List.range 2, p.entry (w+t)=t+2 ∧ 30625<p.entry (2*w+2+t)) ∧
  (∀ i∈List.range (w+2), p.entry i*p.entry (w+2+i)≤256^3) ∧
  (∀ i∈List.range w, ∀ j∈List.range 3, Representation p w i (3*i+j)) ∧
  (∀ t∈List.range 2, Representation p w (w+t) (3*w+t))

instance (w : ℕ) (p : Profile) : Decidable (Valid w p) := by
  unfold Valid Representation Profile.entry
  infer_instance

