def Profile.rAt (p : Profile) (w c : ℕ) : ℕ :=
  if c<w then (p.entry (2*w+4+3*c))*(p.entry (2*w+4+3*c+1))*(p.entry (2*w+4+3*c+2))
  else p.entry (2*w+4+3*w+(c-w))

def Profile.order (p : Profile) (w : ℕ) : ℕ :=
  30625*((List.range (w+2)).map fun c => (p.rAt w c)^2*p.entry c*p.entry (w+2+c)).prod

def Profile.mass (p : Profile) (w : ℕ) : ℕ :=
  30625*((List.range (w+2)).map fun c => p.rAt w c*p.entry c*p.entry (w+2+c)).prod

def SupportValid (p : Profile) (w H : ℕ) : Prop :=
  175≤H ∧
  (∀ c∈List.range w, 32*(p.rAt w c*p.entry c*p.entry (w+2+c))^2≤H) ∧
  ∀ t∈List.range 2, 2*(3-t)*(p.rAt w (w+t)*p.entry (w+t)*p.entry (2*w+2+t))^2*175^3≤H

instance (p : Profile) (w H : ℕ) : Decidable (SupportValid p w H) := by
  unfold SupportValid
