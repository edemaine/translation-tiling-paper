def cover5 : List Pattern := codes5.map (decode 5)

elab "check_partial_word_5" cnf:term:max ppSpace lrat:term:max : command => do
  let ns ← getCurrNamespace
  Command.liftTermElabM do
    let cnf ← unsafe Term.evalTerm String (mkConst ``String) cnf
    let lrat ← unsafe Term.evalTerm String (mkConst ``String) lrat
    let name := ns ++ Name.mkSimple "partial5"
    let pf ← NinePatch.namedFromLRAT cnf lrat name
    let type := mkApp2 (mkConst ``Sat.Fmla.proof)
      (mkApp2 (mkConst ``formula) (mkNatLit 5) (mkConst ``cover5)) (Sat.buildClause #[])
    addDecl <| Declaration.thmDecl {
      name := name ++ Name.mkSimple "unsat", levelParams := [], type, value := pf }

check_partial_word_5
  (include_str "Certificates/partialword5.cnf")
  (include_str "Certificates/partialword5.lrat")

theorem cover5_safe : cover5.all (fun p => (legal 5).all (clashes p)) = true := by
  decide +kernel

