% \leanfilequote[options]{file}{names}: quote declarations from an explicit file.
\NewDocumentCommand \leanfilequote { O{} m m }
  {
    \group_begin:
      \tl_set_eq:NN \l__leanquote_lst_tl \l__leanquote_setuplst_tl
      \keys_set:nn { leanquote } {#1}
      \__leanquote_typeset:nn {#2} {#3}
    \group_end:
  }
% \leanfile[options]{file}: set the current file (and options) for the following \leanquote.
\tl_new:N \l_leanquote_file_tl
\tl_new:N \l__leanquote_fileopts_tl
\msg_new:nnn { leanquote } { no-current-file }
  { \token_to_str:N \leanquote\ used~before~any~\token_to_str:N \leanfile\
    (or~\token_to_str:N \leanquotefile). }
\msg_new:nnn { leanquote } { leanfile-taken }
  { \token_to_str:N \leanfile\ is~already~defined~(for~example~by~blueprint~macros),~
    so~leanquote~leaves~it~alone.~Use~\token_to_str:N \leanquotefile\ instead. }
\NewDocumentCommand \leanquotefile { O{} m }
  {
    \tl_set:Nn \l_leanquote_file_tl {#2}
    \tl_set:Nn \l__leanquote_fileopts_tl {#1}
  }
% \leanfile is the short name of \leanquotefile, defined now if it is free. If a document's
% macros (e.g. a blueprint's) define \leanfile before leanquote is loaded, they keep it.
\cs_if_exist:NTF \leanfile
  { \msg_warning:nn { leanquote } { leanfile-taken } }
  { \NewCommandCopy \leanfile \leanquotefile }
% \leanquoteimports[options]: quote the import block of the current file.
\NewDocumentCommand \leanquoteimports { O{} } { \leanquote[#1]{:imports} }
% \leanquote[options]{names}: quote declarations from the current file.
\NewDocumentCommand \leanquote { O{} m }
  {
    \tl_if_blank:VTF \l_leanquote_file_tl
      { \msg_error:nn { leanquote } { no-current-file } }
      {
        \group_begin:
          \tl_set_eq:NN \l__leanquote_lst_tl \l__leanquote_setuplst_tl
          \keys_set:nV { leanquote } \l__leanquote_fileopts_tl
          \keys_set:nn { leanquote } {#1}
          \exp_args:NV \__leanquote_typeset:nn \l_leanquote_file_tl {#2}
        \group_end:
      }
  }

