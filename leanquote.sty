% UNVERIFIED, USES SORRY, SORRY IN FILE or EXTRA AXIOMS. \leanquotebadge is drawn on a red
% background in the box; \leanquotebadgetext is used without a box.
\cs_new:Npn \leanquotebadge #1
  { \textcolor{white}{ \textsf{ \bfseries \scriptsize #1 } } }
\cs_new:Npn \leanquotebadgetext #1
  { \textcolor{red!75!black}{ \textsf{ \bfseries \scriptsize #1 } } }
