% leanquote.sty -- typeset Lean declarations by name, copied verbatim from Lean sources.
%
%   \leanquotesetup{project=../lean/}            % root of the Lake project (optional)
%   \leanfile{Path/To/File.lean}                  % current file (alias: \leanquotefile)
%   \leanquote[options]{Name1, Name2, ...}        % quote from the current file
%   \leanquoteimports[options]                    % its import block (or the name :imports)
%   \leanfilequote[options]{Path/To/File.lean}{Name1, Name2, ...}   % explicit file
%
% A declaration is found by its `def`/`theorem`/... line in column 0 and runs while lines are
% indented (or start with `|`, `termination_by`, `decreasing_by`, `deriving`); its doc comment
% is shown with the `doc` option. Names may be short (`Tiles`) or qualified (`Abstract.Tiles`).
% An unknown name is an error. If the file is newer than its compiled `.olean`
% (under `project`/.lake/build/lib/lean/), LaTeX warns that it may not be what Lean checked.
% Optional: if `leanquote-export` was run, its export (under `project`/.lake/build/leanquote/, or
% next to the `.lean` file) is used automatically for exact declaration boundaries, as long as
% the `.lean` file has not changed since; otherwise the `.lean` file is read directly.
%
% Copyright 2026 Stefan Langerman and Erik D. Demaine. MIT License.
\NeedsTeXFormat{LaTeX2e}
\ProvidesExplPackage{leanquote}{2026-10-26}{0.14}{Typeset Lean declarations by name}
\RequirePackage{listings}
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{tcolorbox}
\RequirePackage{amssymb}
\tcbuselibrary{skins,breakable}

% ---------------------------------------------------------------- options
\tl_new:N \l__leanquote_lst_tl
\tl_new:N \l_leanquote_verify_tl
\bool_new:N \l_leanquote_check_bool
\keys_define:nn { leanquote }
  {
    root  .tl_set:N   = \l_leanquote_root_tl ,
    root  .initial:n  = {} ,
    doc   .bool_set:N = \l_leanquote_doc_bool ,
    doc   .default:n  = true ,
    doc   .initial:n  = false ,
    proof .bool_set:N = \l_leanquote_proof_bool ,
    proof .default:n  = true ,
    proof .initial:n  = true ,
    style .tl_set:N   = \l_leanquote_style_tl ,
    style .initial:n  = leanquote ,
    box   .bool_set:N = \l_leanquote_box_bool ,
    box   .default:n  = true ,
    box   .initial:n  = true ,
    logo  .tl_set:N   = \l_leanquote_logo_tl ,
    logo  .initial:n  = {} ,
    verify .choices:nn = { true , false , auto }
      { \tl_set_eq:NN \l_leanquote_verify_tl \l_keys_choice_tl } ,
    verify .default:n  = true ,
    verify .initial:n  = auto ,
    check  .meta:n     = { verify = #1 } ,
    check  .default:n  = true ,
    source .tl_set:N  = \l_leanquote_source_tl ,
    source .initial:n = {} ,
    project .tl_set:N  = \l_leanquote_project_tl ,
    project .initial:n = {} ,
    olean .tl_set:N   = \l_leanquote_olean_tl ,
    olean .initial:n  = {} ,
    unknown .code:n   =
      \tl_put_right:Nx \l__leanquote_lst_tl
        { , \l_keys_key_str \tl_if_blank:nF {#1} { = \exp_not:n {#1} } } ,
  }
% Listings settings given to \leanquotesetup (unknown keys) are kept for the whole document
% (or group); those given to a quote or \leanfile are added to them.
\tl_new:N \l__leanquote_setuplst_tl
\NewDocumentCommand \leanquotesetup { m }
  {
    \tl_set_eq:NN \l__leanquote_lst_tl \l__leanquote_setuplst_tl
    \keys_set:nn { leanquote } {#1}
    \tl_set_eq:NN \l__leanquote_setuplst_tl \l__leanquote_lst_tl
  }

% ---------------------------------------------------------------- messages
\msg_new:nnn { leanquote } { not-found }
  { Lean~declaration~`#1'~not~found~in~#2. }
\msg_new:nnn { leanquote } { ambiguous }
  { Lean~name~`#1'~matches~several~declarations~in~#2;~using~the~first.~
    Use~a~fully~qualified~name. }
\msg_new:nnn { leanquote } { no-file }
  { File~`#1'~not~found. }
\msg_new:nnn { leanquote } { stale }
  { #1~has~changed~since~#2~was~exported.~The~code~shown~may~be~out~of~date:~
    rebuild~and~run~leanquote-export~again. }
\msg_new:nnn { leanquote } { uncompiled }
  { #1~is~newer~than~its~compiled~file~#2.~The~code~shown~may~not~be~what~Lean~checked~
    (the~quote~is~marked~UNVERIFIED):~run~lake~build. }
\msg_new:nnn { leanquote } { using-export }
  { Using~#2~for~exact~declaration~boundaries~of~#1. }
\msg_new:nnn { leanquote } { stale-fallback }
  { #1~has~changed~since~it~was~exported~to~#2.~Reading~#1~directly~instead;~
    re-run~leanquote-export~for~exact~declaration~boundaries. }
\msg_new:nnn { leanquote } { no-olean }
  { No~compiled~file~#2~for~#1,~so~leanquote~cannot~check~that~Lean~compiled~it~
    (verify=true:~the~quote~is~marked~UNVERIFIED).~Set~project~to~the~root~of~its~Lake~
    project~or~olean~to~the~compiled~file,~or~use~verify=auto. }
\msg_new:nnn { leanquote } { no-imports }
  { No~import~lines~found~at~the~top~of~#1. }
\msg_new:nnn { leanquote } { failed }
  { The~last~lake~build~of~#1~failed:~its~compiled~file~#2~is~missing~
    (the~quote~is~marked~UNVERIFIED).~Fix~the~Lean~file~and~run~lake~build. }
\msg_new:nnn { leanquote } { sorry-file }
  { #1~contains~sorry,~according~to~Lake's~build~log~(quotes~from~it~are~marked~
    SORRY~IN~FILE).~Run~leanquote-export~to~see~which~declarations~depend~on~it. }
\msg_new:nnn { leanquote } { sorry-decl }
  { Lean~declaration~#1~depends~on~sorry~(the~quote~is~marked~USES~SORRY). }
\msg_new:nnn { leanquote } { extra-axioms }
  { Lean~declaration~#1~depends~on~axioms~beyond~propext,~Classical.choice~and~
    Quot.sound:~#2~(the~quote~is~marked~EXTRA~AXIOMS). }
\msg_new:nnn { leanquote } { no-olean-auto }
  { No~compiled~file~#2~for~#1;~leanquote~cannot~check~it~here~(verify=auto). }

\cs_generate_variant:Nn \msg_warning:nnnn { nnnV , nnVn }
\cs_generate_variant:Nn \msg_error:nnn { nnV }
\cs_generate_variant:Nn \msg_error:nnnn { nnVV }
\cs_generate_variant:Nn \msg_info:nnnn { nnnV }
\cs_generate_variant:Nn \file_if_exist:nTF { V }
\cs_generate_variant:Nn \file_if_exist:nF { V }
\cs_generate_variant:Nn \file_if_exist:nT { V }
\cs_generate_variant:Nn \str_range:nnn { e }

% ---------------------------------------------------------------- state
\ior_new:N \g__leanquote_ior
\iow_new:N \g__leanquote_iow
\int_new:N \g__leanquote_count_int
\str_new:N \l__leanquote_name_str
\str_new:N \l__leanquote_file_str
\str_new:N \l__leanquote_out_str
\bool_new:N \l__leanquote_inside_bool
\bool_new:N \l__leanquote_found_bool
\bool_new:N \l__leanquote_first_bool
\int_new:N \l__leanquote_matches_int
\prop_new:N \g__leanquote_checked_prop

% Write one line to the output file.
% Lines of the declaration being extracted are collected in a buffer, then written.
\seq_new:N \l__leanquote_buf_seq
\cs_new_protected:Npn \__leanquote_write:n #1 { \seq_put_right:Nn \l__leanquote_buf_seq {#1} }

% ---------------------------------------------------------------- hiding proofs (proof=false)
% For a theorem or lemma, cut at the `:=` that starts the proof (outside brackets and `--`
% comments) and print `:= ...` instead. Definitions keep their bodies.
\int_new:N \l__leanquote_depth_int
\int_new:N \l__leanquote_pos_int
\int_new:N \l__leanquote_cut_int
\int_new:N \l__leanquote_prev_int
\bool_new:N \l__leanquote_intheorem_bool
\bool_new:N \l__leanquote_cutdone_bool
\str_new:N \l__leanquote_line_str
\cs_new_protected:Npn \__leanquote_find_cut:N #1
  {% #1 = str variable holding one line; sets \l__leanquote_cut_int (0 = no cut in this line)
    \int_zero:N \l__leanquote_pos_int
    \int_zero:N \l__leanquote_cut_int
    \int_zero:N \l__leanquote_prev_int
    \str_map_inline:Nn #1
      {
        \int_incr:N \l__leanquote_pos_int
        \int_case:nn { `##1 }
          {
            { 40 }    { \int_incr:N \l__leanquote_depth_int }   % (
            { 91 }    { \int_incr:N \l__leanquote_depth_int }   % [
            { 123 }   { \int_incr:N \l__leanquote_depth_int }   % {
            { 10216 } { \int_incr:N \l__leanquote_depth_int }   % ⟨ (Unicode engines)
            { 41 }    { \int_decr:N \l__leanquote_depth_int }
            { 93 }    { \int_decr:N \l__leanquote_depth_int }
            { 125 }   { \int_decr:N \l__leanquote_depth_int }
            { 10217 } { \int_decr:N \l__leanquote_depth_int }
            { 61 }                                              % =
              {
                \bool_lazy_and:nnT
                  { \int_compare_p:nNn { \l__leanquote_prev_int } = { 58 } }
                  { \int_compare_p:nNn { \l__leanquote_depth_int } < { 1 } }
                  {
                    \int_set:Nn \l__leanquote_cut_int { \l__leanquote_pos_int - 1 }
                    \str_map_break:
                  }
              }
            { 45 }                                              % -
              {
                \int_compare:nNnT { \l__leanquote_prev_int } = { 45 }
                  { \str_map_break: }
              }
          }
        \int_set:Nn \l__leanquote_prev_int { `##1 }
      }
  }
\cs_new_protected:Npn \__leanquote_flush:
  {
    \bool_if:NTF \l_leanquote_proof_bool
      { \seq_map_inline:Nn \l__leanquote_buf_seq { \iow_now:Nn \g__leanquote_iow {##1} } }
      {
        \bool_set_false:N \l__leanquote_intheorem_bool
        \bool_set_false:N \l__leanquote_cutdone_bool
        \int_zero:N \l__leanquote_depth_int
        \seq_map_inline:Nn \l__leanquote_buf_seq
          {
            \bool_if:NF \l__leanquote_cutdone_bool
              {
                \str_set:Nn \l__leanquote_line_str {##1}
                \bool_if:NF \l__leanquote_intheorem_bool
                  {
                    \regex_match:nnT
                      { \A (?:@\[ [^\]]* \] \s*)?
                           (?:(?:private|protected|noncomputable|nonrec) \s+)*
                           (?:theorem|lemma) \s }
                      {##1}
                      { \bool_set_true:N \l__leanquote_intheorem_bool }
                  }
                \bool_if:NTF \l__leanquote_intheorem_bool
                  {
                    \__leanquote_find_cut:N \l__leanquote_line_str
                    \int_compare:nNnTF { \l__leanquote_cut_int } > { 0 }
                      {
                        \tl_set:Ne \l_tmpa_tl
                          { \str_range:Nnn \l__leanquote_line_str {1} { \l__leanquote_cut_int - 1 } }
                        \regex_replace_once:nnN { \s* \Z } { } \l_tmpa_tl
                        \iow_now:Ne \g__leanquote_iow { \l_tmpa_tl \c_space_tl := ~ ... }
                        \bool_set_true:N \l__leanquote_cutdone_bool
                      }
                      { \iow_now:Nn \g__leanquote_iow {##1} }
                  }
                  { \iow_now:Nn \g__leanquote_iow {##1} }
              }
          }
      }
    \seq_clear:N \l__leanquote_buf_seq
  }


% ---------------------------------------------------------------- .leanquote exports
% `@@axioms a b c` line of an export: flag sorry and axioms beyond the standard three.
\tl_new:N \l__leanquote_axlist_tl
\tl_new:N \l__leanquote_extra_tl
\cs_new_protected:Npn \__leanquote_axioms:n #1
  {
    \tl_set:Ne \l__leanquote_axlist_tl { \str_range:nnn {#1} {10} {-1} }
    \regex_match:nVT { sorryAx } \l__leanquote_axlist_tl
      {
        \bool_set_true:N \l__leanquote_sorrydecl_bool
        \msg_warning:nnV { leanquote } { sorry-decl } \l__leanquote_name_str
      }
    \tl_set_eq:NN \l__leanquote_extra_tl \l__leanquote_axlist_tl
    \regex_replace_all:nnN { propext | Classical\.choice | Quot\.sound | sorryAx } { } \l__leanquote_extra_tl
    \tl_trim_spaces:N \l__leanquote_extra_tl
    \tl_if_blank:VF \l__leanquote_extra_tl
      {
        \bool_set_true:N \l__leanquote_axioms_bool
        \msg_warning:nnVV { leanquote } { extra-axioms } \l__leanquote_name_str \l__leanquote_axlist_tl
      }
  }
\cs_generate_variant:Nn \regex_match:nnT { nV }
\cs_generate_variant:Nn \msg_warning:nnn { nnV }
\cs_generate_variant:Nn \msg_warning:nnnn { nnVV }
\cs_new_protected:Npn \__leanquote_from_export:n #1
  {
    \bool_set_false:N \l__leanquote_inside_bool
    \bool_set_false:N \l__leanquote_found_bool
    \int_zero:N \l__leanquote_matches_int
    \ior_open:Nn \g__leanquote_ior {#1}
    \ior_str_map_inline:Nn \g__leanquote_ior
      {
        \bool_if:NTF \l__leanquote_inside_bool
          {
            \str_if_eq:nnTF {##1} { @@end }
              { \bool_set_false:N \l__leanquote_inside_bool }
              {
                \regex_match:nnTF { \A @@axioms } {##1}
                  { \bool_if:NT \l_leanquote_check_bool { \__leanquote_axioms:n {##1} } }
                  {
                    \regex_match:nnTF { \A @@doc\x{20} } {##1}
                      {
                        \bool_if:NT \l_leanquote_doc_bool
                          { \seq_put_right:Ne \l__leanquote_buf_seq { \str_range:nnn {##1} {7} {-1} } }
                      }
                      { \__leanquote_write:n {##1} }
                  }
              }
          }
          {
            \regex_match:nnT { \A @@begin\x{20} (.*\.)? \u{l__leanquote_name_str} \Z } {##1}
              {
                \int_incr:N \l__leanquote_matches_int
                \bool_if:NF \l__leanquote_found_bool
                  {
                    \bool_set_true:N \l__leanquote_inside_bool
                    \bool_set_true:N \l__leanquote_found_bool
                  }
              }
          }
      }
    \ior_close:N \g__leanquote_ior
  }

% ---------------------------------------------------------------- .lean files
% A declaration starts at a line `[@[...]] [modifiers] def|theorem|... Name` in column 0, with
% the doc comment and attribute lines just above it, and continues while lines are blank,
% indented, or start with `|`, `termination_by`, `decreasing_by` or `deriving`.
\seq_new:N \l__leanquote_doc_seq
\seq_new:N \l__leanquote_attr_seq
\seq_new:N \l__leanquote_blank_seq
\bool_new:N \l__leanquote_indoc_bool
\bool_new:N \l__leanquote_consumed_bool
\cs_new_protected:Npn \__leanquote_src_inside:n #1
  {
    \regex_match:nnTF { \A \s* \Z } {#1}
      { \seq_put_right:Nn \l__leanquote_blank_seq { } \bool_set_true:N \l__leanquote_consumed_bool }
      {
        \regex_match:nnTF { \A ( \s | \| | termination_by | decreasing_by | deriving ) } {#1}
          {
            \seq_map_inline:Nn \l__leanquote_blank_seq { \__leanquote_write:n { } }
            \seq_clear:N \l__leanquote_blank_seq
            \__leanquote_write:n {#1}
            \bool_set_true:N \l__leanquote_consumed_bool
          }
          {
            \bool_set_false:N \l__leanquote_inside_bool
            \seq_clear:N \l__leanquote_blank_seq
          }
      }
  }
\seq_new:N \l__leanquote_decl_seq
\str_new:N \l__leanquote_declname_str
% Does the declared name match the requested one? Either may be a dotted suffix of the other.
\cs_generate_variant:Nn \regex_match:nnTF { nV }
\prg_new_protected_conditional:Npnn \__leanquote_names_match: { TF }
  {
    \str_if_eq:NNTF \l__leanquote_declname_str \l__leanquote_name_str
      { \prg_return_true: }
      {
        \regex_match:nVTF { \. \u{l__leanquote_name_str} \Z } \l__leanquote_declname_str
          { \prg_return_true: }
          {
            \regex_match:nVTF { \. \u{l__leanquote_declname_str} \Z } \l__leanquote_name_str
              { \prg_return_true: } { \prg_return_false: }
          }
      }
  }
\cs_new_protected:Npn \__leanquote_src_start:n #1
  {
                \int_incr:N \l__leanquote_matches_int
                \bool_if:NF \l__leanquote_found_bool
                  {
                    \bool_set_true:N \l__leanquote_found_bool
                    \bool_set_true:N \l__leanquote_inside_bool
                    \bool_if:NT \l_leanquote_doc_bool
                      { \seq_map_inline:Nn \l__leanquote_doc_seq { \__leanquote_write:n {##1} } }
                    \seq_map_inline:Nn \l__leanquote_attr_seq { \__leanquote_write:n {##1} }
                    \__leanquote_write:n {#1}
                  }
              }
\cs_new_protected:Npn \__leanquote_src_other:n #1
  {
                \regex_match:nnTF { \A @\[ } {#1}
                  { \seq_put_right:Nn \l__leanquote_attr_seq {#1} }
                  {
                    \regex_match:nnF { \A \s* \Z } {#1}
                      {
                        \seq_clear:N \l__leanquote_doc_seq
                        \seq_clear:N \l__leanquote_attr_seq
                      }
                  }
              }
\cs_new_protected:Npn \__leanquote_src_outside:n #1
  {
    \bool_if:NTF \l__leanquote_indoc_bool
      {
        \seq_put_right:Nn \l__leanquote_doc_seq {#1}
        \regex_match:nnT { -/ } {#1} { \bool_set_false:N \l__leanquote_indoc_bool }
      }
      {
        \regex_match:nnTF { \A /-- } {#1}
          {
            \seq_clear:N \l__leanquote_doc_seq
            \seq_clear:N \l__leanquote_attr_seq
            \seq_put_right:Nn \l__leanquote_doc_seq {#1}
            \regex_match:nnF { \A /-- .* -/ } {#1} { \bool_set_true:N \l__leanquote_indoc_bool }
          }
          {
            \regex_extract_once:nnNTF
              { \A (?:@\[ [^\]]* \] \s*)?
                   (?:(?:private|protected|noncomputable|partial|unsafe|nonrec) \s+)*
                   (?:def|theorem|lemma|abbrev|structure|inductive|instance|class|axiom|opaque)
                   \s+ ([^\s:(\[\{]+) }
              {#1} \l__leanquote_decl_seq
              {
                \str_set:Ne \l__leanquote_declname_str { \seq_item:Nn \l__leanquote_decl_seq {2} }
                \__leanquote_names_match:TF { \__leanquote_src_start:n {#1} } { \__leanquote_src_other:n {#1} }
              }
              { \__leanquote_src_other:n {#1} }

          }
      }
  }
% ---------------------------------------------------------------- the import block
% The `module` / `[public|private|meta] import` lines at the top of a file. A comment before them
% (e.g. a copyright header) is skipped; the block ends at the first other non-blank line.
\bool_new:N \l__leanquote_inheader_bool
\bool_new:N \l__leanquote_incomment_bool
\cs_new_protected:Npn \__leanquote_import_line:n #1
  {
    \bool_if:NTF \l__leanquote_incomment_bool
      { \regex_match:nnT { -/ } {#1} { \bool_set_false:N \l__leanquote_incomment_bool } }
      {
        \regex_match:nnTF
          { \A (?: module \s* \Z | (?:(?:public|private|meta) \s+)* import \s ) } {#1}
          {
            \bool_set_true:N \l__leanquote_found_bool
            \bool_set_true:N \l__leanquote_inheader_bool
            \__leanquote_write:n {#1}
          }
          {
            \regex_match:nnF { \A \s* (?: \Z | -- ) } {#1}
              {
                \bool_if:NTF \l__leanquote_inheader_bool
                  { \ior_map_break: }
                  {
                    \regex_match:nnTF { \A /- } {#1}
                      {
                        \regex_match:nnF { -/ } {#1}
                          { \bool_set_true:N \l__leanquote_incomment_bool }
                      }
                      { \ior_map_break: }
                  }
              }
          }
      }
  }
\cs_new_protected:Npn \__leanquote_imports:n #1
  {% #1 = .lean file, or export (its @@src lines)
    \bool_set_false:N \l__leanquote_found_bool
    \bool_set_false:N \l__leanquote_inheader_bool
    \bool_set_false:N \l__leanquote_incomment_bool
    \int_set:Nn \l__leanquote_matches_int { 1 }
    \ior_open:Nn \g__leanquote_ior {#1}
    \str_if_eq:eeTF { \str_range:nnn {#1} {-5} {-1} } { .lean }
      { \ior_str_map_inline:Nn \g__leanquote_ior { \__leanquote_import_line:n {##1} } }
      {
        \ior_str_map_inline:Nn \g__leanquote_ior
          {
            \regex_match:nnT { \A @@src (\x{20} | \Z) } {##1}
              { \exp_args:Ne \__leanquote_import_line:n { \str_range:nnn {##1} {7} {-1} } }
          }
      }
    \ior_close:N \g__leanquote_ior
  }
\cs_generate_variant:Nn \__leanquote_imports:n { V }
\str_const:Nn \c__leanquote_imports_str { :imports }
\bool_new:N \l__leanquote_hasdecl_bool

\cs_new_protected:Npn \__leanquote_from_source:n #1
  {
    \bool_set_false:N \l__leanquote_inside_bool
    \bool_set_false:N \l__leanquote_found_bool
    \bool_set_false:N \l__leanquote_indoc_bool
    \int_zero:N \l__leanquote_matches_int
    \seq_clear:N \l__leanquote_doc_seq
    \seq_clear:N \l__leanquote_attr_seq
    \seq_clear:N \l__leanquote_blank_seq
    \ior_open:Nn \g__leanquote_ior {#1}
    \ior_str_map_inline:Nn \g__leanquote_ior
      {
        \bool_set_false:N \l__leanquote_consumed_bool
        \bool_if:NT \l__leanquote_inside_bool { \__leanquote_src_inside:n {##1} }
        \bool_if:NF \l__leanquote_consumed_bool { \__leanquote_src_outside:n {##1} }
      }
