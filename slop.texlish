      \node[text=figgreen] at (3.65,1.125) {$3$};
      \node[text=figgreen] at (3.65,.375) {$3$};
      \node[font=\scriptsize,text=figgreen] at (3.65,1.95) {sum};
      \foreach \x in {0,1,2} {\node[text=figgreen] at (1.05*\x+.525,-.35) {$2$};}
      \node[font=\scriptsize,text=figgreen] at (-.4,-.35) {sum};
      \end{tikzpicture}
    \end{minipage}%
  }
  \hfil
  \subcaptionbox{Six distinct list indices\label{fig:activation-indices}}[.54\linewidth]{%
    \begin{minipage}[c][3.1cm][c]{\linewidth}
      \centering
