    \begin{minipage}[c][3.1cm][c]{\linewidth}
      \centering
      \begin{tikzpicture}[font=\small,x=1cm,y=1cm,>=Latex]
      \foreach \xi in {0,1,2} {
        \node at (1.05*\xi+.525,1.95) {$\xi$};
        \draw[black!50] (1.05*\xi,0) rectangle +(1.05,1.5);
        \draw[black!50] (1.05*\xi,.75) -- +(1.05,0);
      }
      \node at (1.575,2.35) {$\xi$};
      \node at (-.4,1.125) {$0$};
      \node at (-.4,.375) {$1$};
      \node at (-.9,.75) {$\alpha$};
      \foreach \x/\y/\value in {0/.75/2,1.05/.75/0,2.1/.75/1,0/0/0,1.05/0/2,2.1/0/1} {
        \ifnum\value=2\def\shade{figblue!20}\else\def\shade{black!3}\fi
        \fill[\shade] (\x+.01,\y+.01) rectangle + (1.03,.73);
